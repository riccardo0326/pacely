generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String   @id @default(cuid())
  stravaAthleteId String   @unique
  name            String
  email           String?
  /// MVP: `athlete`. Stored as string so a future `coach` value is additive.
  role            String   @default("athlete")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stravaConnection           StravaConnection?
  activities                 Activity[]
  jobs                       Job[]
  llmInteractionLogs         LLMInteractionLog[]
  programs                   Program[]
  performanceMetricSnapshots PerformanceMetricSnapshot[]
  performanceReports         PerformanceReport[]
}

model StravaConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  scope                 String
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Imported Strava activity (run / swim / ride). Always queried with userId.
model Activity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaActivityId  String
  /// `run` | `swim` | `ride`
  sport             String
  name              String?
  startedAt         DateTime
  /// moving_time when present, otherwise elapsed_time
  durationSec       Int
  elapsedSec        Int?
  distanceM         Float?
  elevationGainM    Float?
  averageHeartrate  Float?
  maxHeartrate      Float?
  averageWatts      Float?
  weightedWatts     Float?
  averageCadence    Float?
  averageSpeedMps   Float?
  perceivedExertion Int?
  splits            Json?
  /// Original Strava payload, kept to reprocess without another API pass.
  sourceRaw         Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  matchedWorkouts Workout[]

  @@unique([userId, stravaActivityId])
  @@index([userId, startedAt])
}

/// Lightweight async queue (backfill, later metric jobs). Status: pending/running/done/failed.
model Job {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  status     String
  progress   Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, type])
  @@index([status, type])
}

/// Token usage and estimated USD cost for every LLM call (Fase 4).
model LLMInteractionLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `generate_program` | `analyze_feedback` | `analyze_performance`
  interactionType  String
  provider         String
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  /// Estimated USD from published list prices, not a billed invoice.
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  success          Boolean
  usedFallback     Boolean  @default(false)
  error            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, interactionType])
}

/// Daily PMC + current thresholds. Recalculated when activities change.
model PerformanceMetricSnapshot {
  id                          String   @id @default(cuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                        DateTime @db.Date
  ctl                         Float
  atl                         Float
  tsb                         Float
  ftp                         Float?
  vdot                        Float?
  swimThresholdPaceSecPer100m Float?
  /// `{ run?: { tss, durationSec, activityCount }, swim?: ..., ride?: ... }`
  sportBreakdown              Json
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Multi-sport training program (Fase 5).
model Program {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  /// `run` | `swim` | `ride`
  sportsIncluded  String[]
  durationWeeks   Int
  /// `draft` | `active` | `completed` | `archived`
  status          String           @default("active")
  startDate       DateTime
  constraints     String?
  /// [{ weekday: 0-6, timeOfDay?: string }]
  availableSlots  Json
  summary         String?
  goal            Goal?
  weeks           Week[]
  recalcProposals RecalcProposal[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
}

model Goal {
  id          String    @id @default(cuid())
  programId   String    @unique
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// `race` | `generic`
  type        String
  description String
  raceType    String?
  distance    String?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Week {
  id              String           @id @default(cuid())
  programId       String
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  number          Int
  weekLoadTarget  Float
  focus           String?
  workouts        Workout[]
  recalcProposals RecalcProposal[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([programId, number])
}

model Workout {
  id          String           @id @default(cuid())
  weekId      String
  week        Week             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  sport       String
  plannedDate DateTime
  dayOfWeek   Int
  name        String
  durationMin Int
  tss         Float
  timeOfDay   String?
  blocks      Json
  /// `planned` | `completed` | `skipped`
  status      String           @default("planned")
  /// `auto` | `manual`. Null until a match or a user override.
  matchSource String?
  activityId  String?          @unique
  activity    Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  feedback    WorkoutFeedback?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([weekId, plannedDate])
  @@index([plannedDate])
}

/// Free-text post-workout note plus structured LLM extraction (Fase 7).
model WorkoutFeedback {
  id        String   @id @default(cuid())
  workoutId String   @unique
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  freeText  String
  /// `FeedbackAnalysisOutput` JSON (RPE, factors, planDeviation, suggestedAction).
  analysis  Json
  createdAt DateTime @default(now())

  proposal RecalcProposal?
}

/// Suggested plan edits; never applied until the athlete approves (Fase 7).
model RecalcProposal {
  id         String           @id @default(cuid())
  programId  String
  program    Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekId     String?
  week       Week?            @relation(fields: [weekId], references: [id], onDelete: SetNull)
  feedbackId String?          @unique
  feedback   WorkoutFeedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  rationale  String
  /// `RecalcChanges` JSON: action + per-workout from/to patches.
  changes    Json
  /// `pending` | `approved` | `rejected`
  status     String           @default("pending")
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([programId, status])
}

/// Periodic LLM performance summary (Fase 8). Informational only — does not change the plan.
model PerformanceReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /// `PerformanceReportOutput` JSON: summary, strengths, improvements, suggestions.
  content     Json
  /// `scheduled` | `on_demand`
  source      String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, periodEnd])
}
