generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String   @id @default(cuid())
  stravaAthleteId String   @unique
  name            String
  email           String?
  /// MVP: `athlete`. Stored as string so a future `coach` value is additive.
  role            String   @default("athlete")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stravaConnection   StravaConnection?
  activities         Activity[]
  jobs               Job[]
  llmInteractionLogs LLMInteractionLog[]
}

model StravaConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  scope                 String
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Imported Strava activity (run / swim / ride). Always queried with userId.
model Activity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaActivityId  String
  /// `run` | `swim` | `ride`
  sport             String
  name              String?
  startedAt         DateTime
  /// moving_time when present, otherwise elapsed_time
  durationSec       Int
  elapsedSec        Int?
  distanceM         Float?
  elevationGainM    Float?
  averageHeartrate  Float?
  maxHeartrate      Float?
  averageWatts      Float?
  weightedWatts     Float?
  averageCadence    Float?
  averageSpeedMps   Float?
  perceivedExertion Int?
  splits            Json?
  /// Original Strava payload, kept to reprocess without another API pass.
  sourceRaw         Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, stravaActivityId])
  @@index([userId, startedAt])
}

/// Lightweight async queue (backfill, later metric jobs). Status: pending/running/done/failed.
model Job {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  status     String
  progress   Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, type])
  @@index([status, type])
}

/// Token usage and estimated USD cost for every LLM call (Fase 4).
model LLMInteractionLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `generate_program` | `analyze_feedback` | `analyze_performance`
  interactionType  String
  provider         String
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  /// Estimated USD from published list prices, not a billed invoice.
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  success          Boolean
  usedFallback     Boolean  @default(false)
  error            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, interactionType])
}
