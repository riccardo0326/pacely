# Postgres (Neon). `neon env pull` writes pooled DATABASE_URL and
# unpooled DATABASE_URL_UNPOOLED (used by Prisma migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
NEON_BRANCH=""

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Strava OAuth + webhook + cron fallback
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_WEBHOOK_VERIFY_TOKEN=""
CRON_SECRET=""

# 32-byte key used to encrypt Strava tokens at rest (hex or base64)
ENCRYPTION_KEY=""

# LLM abstraction (`/lib/llm`). Default provider is DeepSeek to keep costs low.
# Set the API key for the selected provider (both keys can be present).
# Per-call override: `getLLMProvider({ provider: "openai" })`.
LLM_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# Web Push (VAPID)
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""

# Sentry (optional). Client-side capture also needs NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
