# Postgres (Neon). Use the pooled connection for DATABASE_URL and the
# direct (unpooled) connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Strava OAuth + webhook
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_WEBHOOK_VERIFY_TOKEN=""

# 32-byte key used to encrypt Strava tokens at rest (hex or base64)
ENCRYPTION_KEY=""

# LLM abstraction (/lib/llm). Default provider is DeepSeek to keep costs low.
LLM_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# Web Push (VAPID)
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""

# Sentry (optional). Client-side capture also needs NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
